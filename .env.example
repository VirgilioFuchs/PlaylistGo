# Backend: replace the two OAuth placeholders with your own Desktop client.
APP_ENV=development
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/musicgo
CLIENT_ID=your-google-desktop-oauth-client-id
CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_TOKEN_PATH=youtube_token.json
YOUTUBE_SEARCH_DAILY_BUDGET=100
FRONTEND_ORIGIN=http://localhost:5173

# Frontend: no environment file is needed with the default Vite development proxy.
# For a custom API URL, set VITE_API_BASE_URL in web/.env.local or at build time.
# VITE_API_BASE_URL=http://localhost:8080
